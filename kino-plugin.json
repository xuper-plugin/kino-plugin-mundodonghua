{
  "id": "mundodonghua",
  "name": "MundoDonghua",
  "version": "0.5.12",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Donghua (animación china) en español de mundodonghua.com: sección propia, 32 géneros, nuevos episodios, series y películas, en latino, castellano o subtitulado.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-mundodonghua",
  "hosts": [
    "raw.githubusercontent.com",
    "mundodonghua.com",
    "www.mundodonghua.com",
    "bysekoze.com",
    "voe.sx",
    "vgembed.com",
    "strp2p.com",
    "*.strp2p.com",
    "mdplayer.xyz",
    "www.mdplayer.xyz",
    "mdnemonicplayer.xyz",
    "www.mdnemonicplayer.xyz",
    "vidhide.com",
    "callistanise.com",
    "vidhidepro.com",
    "vidhideplus.com",
    "vidhidefast.com",
    "dintezuvio.com",
    "minochinos.com",
    "filelions.to",
    "morencius.com",
    "embedwish.com",
    "hlswish.com",
    "streamwish.com",
    "streamwish.to",
    "strwish.com",
    "wishembed.com",
    "filelions.com",
    "hglink.to",
    "vibuxer.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "scopedSearch",
    "screen"
  ],
  "browser": true,
  "streamHosts": "any",
  "fetchHosts": "any",
  "categories": [
    "series",
    "movies"
  ],
  "color": "#A21CAF",
  "section": {
    "label": "Donghua",
    "labelEn": "Donghua"
  },
  "theme": {
    "accent": "#A21CAF",
    "onAccent": "#FFFFFF",
    "background": "#12081A",
    "surface": "#1F1030",
    "highlight": "#F0ABFC"
  },
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Elige qué donghua salen en las listas, los géneros y la búsqueda.",
      "hintEn": "Choose which donghua show in lists, genres and search."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Mostrar",
      "labelEn": "Show",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todos",
          "labelEn": "All"
        },
        {
          "value": "dub",
          "label": "Solo doblados (latino o castellano)",
          "labelEn": "Dubbed only (Latino or Castilian)"
        },
        {
          "value": "sub",
          "label": "Solo subtitulados",
          "labelEn": "Subtitled only"
        }
      ]
    },
    {
      "key": "serverSection",
      "type": "section",
      "label": "Servidor",
      "labelEn": "Server",
      "hint": "Cada episodio ofrece hasta cinco servidores; Kino abre primero el que elijas y, si falla, los demás.",
      "hintEn": "Each episode offers up to five servers; Kino opens the one you pick first and, if it fails, the others."
    },
    {
      "key": "server",
      "type": "select",
      "label": "Servidor preferido",
      "labelEn": "Preferred server",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático",
          "labelEn": "Automatic"
        },
        {
          "value": "vhide",
          "label": "VidHide",
          "labelEn": "VidHide"
        },
        {
          "value": "swish",
          "label": "StreamWish",
          "labelEn": "StreamWish"
        },
        {
          "value": "fmoon",
          "label": "Filemoon",
          "labelEn": "Filemoon"
        },
        {
          "value": "amagi",
          "label": "VOE",
          "labelEn": "VOE"
        },
        {
          "value": "sp2p",
          "label": "StreamP2P",
          "labelEn": "StreamP2P"
        },
        {
          "value": "asura",
          "label": "Asura",
          "labelEn": "Asura"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas?",
      "confirmEn": "Clear the list cache?"
    }
  ],
  "telemetry": true,
  "screen": {
    "label": "MundoDonghua",
    "labelEn": "MundoDonghua",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir MundoDonghua",
      "labelEn": "Open MundoDonghua"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?",
            "tmdb": "number?"
          },
          "out": "Item[]"
        },
        "episodes": {
          "in": {
            "ref": "string"
          },
          "out": "Episode[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        },
        "Episode": {
          "season": "number",
          "number": "number",
          "ref": "string",
          "title": "string?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "2ee446a4b2aa1f701968dfe97c1160a2752d47d6252c0b14f696d70f93be60f3c7a6f9e1bd9db9499d9e956b63d30cc3fc9468a10e4115099a4d2529bcc21f0d"
  }
}
